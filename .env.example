# Copy to .env.local. Never commit .env.local.

# Neon Postgres connection string (Dashboard → Connect).
DATABASE_URL=

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Welcome email via Brevo. Leave both empty and the app logs instead of
# sending — safe for local dev and preview deploys.
BREVO_API_KEY=
MAIL_FROM=

# Canonical origin for share links and the OG card. Defaults to the
# production domain in lib/site.ts; set only to override.
# NEXT_PUBLIC_SITE_URL=

# Comma-separated Google emails allowed to open /admin. Unset = nobody.
ADMIN_EMAILS=
